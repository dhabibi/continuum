<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shadowbox_caption_scrim">

    <LinearLayout
        android:id="@+id/caption_shadowbox_info_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="60dp"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/action_row_shadowbox_info_panel"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/header_shadowbox_info_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/user_text_view_shadowbox_info_panel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="14sp"
                android:fontFamily="?attr/font_family" />
            <TextView
                android:id="@+id/post_time_text_view_shadowbox_info_panel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:textColor="#DDFFFFFF"
                android:textSize="11sp"
                android:fontFamily="?attr/font_family" />
        </LinearLayout>

        <TextView
            android:id="@+id/title_text_view_shadowbox_info_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="5dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:fontFamily="?attr/title_font_family" />

        <TextView
            android:id="@+id/subreddit_name_text_view_shadowbox_info_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="5dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:fontFamily="?attr/font_family" />

        <LinearLayout
            android:id="@+id/tags_row_shadowbox_info_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:orientation="horizontal">
            <com.libRG.CustomTextView
                android:id="@+id/type_text_view_shadowbox_info_panel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:padding="2dp"
                app:lib_setRadius="4dp"
                app:lib_setRoundedView="true" />
            <com.libRG.CustomTextView
                android:id="@+id/flair_custom_text_view_shadowbox_info_panel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="10sp"
                android:padding="2dp"
                android:visibility="gone"
                app:lib_setRadius="4dp"
                app:lib_setRoundedView="true" />
        </LinearLayout>
        <TextView
            android:id="@+id/link_text_view_shadowbox_info_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#DDFFFFFF"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/action_row_shadowbox_info_panel"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="44dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/icon_image_view_shadowbox_info_panel"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginBottom="6dp"
            android:contentDescription="@string/shadowbox_open_community" />

        <com.google.android.material.button.MaterialButton
            style="?attr/materialIconButtonStyle"
            android:id="@+id/upvote_button_shadowbox_info_panel"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:contentDescription="@string/shadowbox_like_action"
            app:backgroundTint="@android:color/transparent"
            app:icon="@drawable/ic_favorite_24dp"
            app:iconTint="@android:color/white"
            app:iconSize="32dp"
            app:iconPadding="0dp"
            app:strokeWidth="0dp" />
        <TextView
            android:id="@+id/score_text_view_shadowbox_info_panel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@android:color/white" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/downvote_button_shadowbox_info_panel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            style="?attr/materialIconButtonStyle"
            android:id="@+id/comments_count_button_shadowbox_info_panel"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:contentDescription="@string/shadowbox_open_comments"
            app:backgroundTint="@android:color/transparent"
            app:icon="@drawable/ic_comment_grey_24dp"
            app:iconTint="@android:color/white"
            app:iconSize="30dp"
            app:iconGravity="textTop"
            app:iconPadding="2dp"
            app:strokeWidth="0dp" />
        <com.google.android.material.button.MaterialButton
            style="?attr/materialIconButtonStyle"
            android:id="@+id/save_button_shadowbox_info_panel"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:visibility="visible"
            android:contentDescription="@string/save"
            app:backgroundTint="@android:color/transparent"
            app:icon="@drawable/ic_bookmark_border_grey_24dp"
            app:iconTint="@android:color/white"
            app:iconSize="28dp"
            app:iconPadding="0dp"
            app:strokeWidth="0dp" />
        <com.google.android.material.button.MaterialButton
            style="?attr/materialIconButtonStyle"
            android:id="@+id/share_button_shadowbox_info_panel"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:visibility="visible"
            android:contentDescription="@string/share"
            app:backgroundTint="@android:color/transparent"
            app:icon="@drawable/ic_share_toolbar_white_24dp"
            app:iconTint="@android:color/white"
            app:iconSize="28dp"
            app:iconPadding="0dp"
            app:strokeWidth="0dp" />
        <com.google.android.material.button.MaterialButton
            style="?attr/materialIconButtonStyle"
            android:id="@+id/mute_button_shadowbox_info_panel"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:visibility="gone"
            android:contentDescription="@string/shadowbox_volume"
            app:backgroundTint="@android:color/transparent"
            app:icon="@drawable/ic_unmute_24dp"
            app:iconTint="@android:color/white"
            app:iconSize="28dp"
            app:iconPadding="0dp"
            app:strokeWidth="0dp" />
        <com.google.android.material.button.MaterialButton
            style="?attr/materialIconButtonStyle"
            android:id="@+id/more_button_shadowbox_info_panel"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:visibility="visible"
            android:contentDescription="@string/shadowbox_more_options"
            app:backgroundTint="@android:color/transparent"
            app:icon="@drawable/ic_more_vert_white_24dp"
            app:iconTint="@android:color/white"
            app:iconSize="28dp"
            app:iconPadding="0dp"
            app:strokeWidth="0dp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
