<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view_shadowbox_media_video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:surface_type="texture_view"
        app:resize_mode="fit" />

    <!-- Gestures stay in these fixed layout coordinates while only the TextureView is transformed. -->
    <View
        android:id="@+id/video_gesture_overlay_shadowbox_media_video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:longClickable="true"
        android:importantForAccessibility="no" />

    <!-- The post's preview, over the player rather than under it: the picture is what a page
         shows until the video is really running, so nothing appears out of a black surface. -->
    <ImageView
        android:id="@+id/preview_image_view_shadowbox_media_video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <com.google.android.material.loadingindicator.LoadingIndicator
        android:id="@+id/progress_bar_shadowbox_media_video"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <!-- This page's play/pause control: shown while the video is paused, and whenever the bar is
         up, so the same spot starts and stops playback. Sized and tinted as the feed's exo_play
         button is (exo_autoplay_playback_control_view: a 24dp icon with 8dp of padding, 40dp
         across, on exo_player_control_button_circular_background's #40000000). -->
    <com.google.android.material.button.MaterialButton
        style="?attr/materialIconButtonOutlinedStyle"
        android:id="@+id/play_button_shadowbox_media_video"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:padding="8dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:contentDescription="@string/shadowbox_play_pause"
        android:visibility="gone"
        app:strokeWidth="0dp"
        app:backgroundTint="#40000000"
        app:icon="@drawable/ic_play_arrow_24dp"
        app:iconTint="@android:color/white"
        app:iconSize="24dp"
        app:iconGravity="textStart"
        app:iconPadding="0dp" />

    <LinearLayout
        android:id="@+id/playback_controls_shadowbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/volume_row_shadowbox"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="#CC000000"
            android:visibility="gone">
            <ImageButton
                android:id="@+id/seek_back_shadowbox"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_fast_rewind_24dp"
                android:tint="@android:color/white"
                android:contentDescription="@string/shadowbox_seek_back" />
            <ImageButton
                android:id="@+id/seek_forward_shadowbox"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_fast_forward_24dp"
                android:tint="@android:color/white"
                android:contentDescription="@string/shadowbox_seek_forward" />
            <ImageButton
                android:id="@+id/mute_shadowbox"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_volume_up_32dp"
                android:tint="@android:color/white"
                android:contentDescription="@string/shadowbox_mute" />
            <SeekBar
                android:id="@+id/volume_shadowbox"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:max="100"
                android:thumbTint="@android:color/white"
                android:progressTint="@android:color/white"
                android:contentDescription="@string/shadowbox_volume" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/playback_times_shadowbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView
                android:id="@+id/playback_position_shadowbox"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/playback_duration_shadowbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="11sp" />
        </LinearLayout>
        <SeekBar
            android:id="@+id/seek_position_shadowbox"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:paddingHorizontal="16dp"
            android:max="10000"
            android:splitTrack="false"
            android:progressDrawable="@drawable/shadowbox_seek_track"
            android:thumb="@drawable/shadowbox_seek_thumb"
            android:contentDescription="@string/shadowbox_seek" />
    </LinearLayout>

    <!-- Shown once the player has given up on the file, over everything else so the play button
         cannot be pressed on a dead player; laid out the way the image page's error is. A tap on
         it starts the video over. Black of its own rather than borrowing the root's: a video that
         failed part-way through has already put frames on the texture view, which keeps the last
         one, and white text with no background is not readable over a video frame. The image page
         needs none because nothing there draws before its error. -->
    <LinearLayout
        android:id="@+id/playback_error_linear_layout_shadowbox_media_video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:drawableTopCompat="@drawable/ic_error_outline_white_24dp"
            android:fontFamily="?attr/font_family"
            android:gravity="center"
            android:text="@string/video_error_tap_to_retry"
            android:textColor="@android:color/white"
            android:textSize="?attr/font_default" />

    </LinearLayout>

</FrameLayout>
