<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- The page reserves the available height before the image arrives. fitCenter keeps
             portrait images inside the viewport, above their caption and the info panel. -->
        <pl.droidsonroids.gif.GifImageView
            android:id="@+id/image_view_item_shadowbox_gallery"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <!-- Shown when an item has no still to load, or its load failed. The row keeps the
             height the ratio reserved for it either way, so nothing in the list moves. -->
        <ImageView
            android:id="@+id/error_image_view_item_shadowbox_gallery"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:padding="12dp"
            android:src="@drawable/ic_error_outline_white_24dp"
            android:visibility="gone"
            android:contentDescription="@string/shadowbox_gallery_item_error"
            app:tint="@android:color/white" />

        <ImageView
            android:id="@+id/play_badge_image_view_item_shadowbox_gallery"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:padding="12dp"
            android:src="@drawable/ic_play_circle_36dp"
            android:visibility="gone"
            android:contentDescription="@null"
            app:tint="@android:color/white" />

    </FrameLayout>

    <TextView
        android:id="@+id/caption_text_view_item_shadowbox_gallery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="4"
        android:ellipsize="end"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:textColor="#CCFFFFFF"
        android:textSize="?attr/font_default"
        android:fontFamily="?attr/font_family"
        android:visibility="gone" />

</LinearLayout>
